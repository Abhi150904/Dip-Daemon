  "narrative": {
    "northStar": "Restrained trading workspace",
    "overview": "The inherited dark and green interface is a restrained operating workspace. Dense financial information, explicit execution state and readable controls take priority over decoration.\n\nOpaque surfaces and thin boundaries organize the account, research and automation tools. Installed sans-serif UI and monospace financial values require no external font request.",
    "keyCharacteristics": [
      "Restrained dark surfaces with green action identity.",
      "Dense real tables and tabular financial numerals.",
      "Explicit PAPER, synthetic-data and risk state."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Pair semantic color with status text, signed values or explicit labels.",
        "section": "colors"
      },
      {
        "name": "The Numeric Truth Rule",
        "body": "Show paise as INR with two decimals; preserve unavailable values as an em dash rather than zero.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use opaque tonal surfaces and thin borders to establish hierarchy.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep keyboard focus visible with the green outline.",
      "Do contain wide tables in their own horizontal scroll area.",
      "Do distinguish paper execution and synthetic data with explicit labels."
    ],
    "donts": [
      "Don't add CRT overlays, glow or gradients to the operating interface.",
      "Don't imply a positive result using color alone.",
      "Don't replace unknown financial values with zero."
    ]
  }
