{
  "name": "dipdaemon",
  "version": "0.1.0",
  "description": "DipDaemon — Scan. Simulate. Trade. NSE trading research platform; foundation runs in observe mode with live orders disabled.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhi150904/Dip-Daemon.git"
  },
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "report": "tsx scripts/report.ts",
    "gates": "tsx scripts/gates.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:safety": "tsx --test scripts/safety.test.ts scripts/lifecycle.test.ts",
    "test:paper": "tsx --test scripts/paper.test.ts",
    "test:automation": "tsx --test scripts/automation.test.ts",
    "paper:demo": "tsx scripts/paper-demo.ts",
    "test": "tsx --test scripts/safety.test.ts scripts/lifecycle.test.ts scripts/paper.test.ts scripts/automation.test.ts scripts/dashboard.test.js scripts/backtest.test.ts scripts/operations.test.ts",
    "test:operations": "tsx --test scripts/operations.test.ts",
    "test:backtest": "tsx --test scripts/backtest.test.ts",
    "backtest:fixture": "tsx scripts/backtest-fixture.ts",
    "auth:token": "tsx scripts/auth-token.ts",
    "backup": "tsx scripts/backup.ts",
    "probe": "tsx scripts/probe.ts",
    "zerodha:preflight": "tsx scripts/zerodha-preflight.ts",
    "zerodha:sandbox": "node scripts/zerodha-sandbox.mjs",
    "zerodha:sandbox-bot": "tsx scripts/zerodha-sandbox-bot.ts",
    "replay": "tsx scripts/replay.ts",
    "zerodha:login": "tsx scripts/zerodha-login.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ai": "7.0.105",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.2",
    "otplib": "^12.0.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
